@@ -0,0 +1,123 @@
+/* Stage 6A: read-only report preview and evidence-frame selection. */
+.ppe-report-backdrop {
+  position: fixed;
+  z-index: 120;
+  inset: 0;
+  display: flex;
+  align-items: center;
+  justify-content: center;
+  padding: 20px;
+  background: rgba(9, 23, 40, .79);
+}
+.ppe-report-dialog {
+  width: min(1160px, 100%);
+  max-height: calc(100vh - 40px);
+  display: flex;
+  flex-direction: column;
+  overflow: hidden;
+  border-radius: 15px;
+  background: #f3f7fb;
+  color: #152a44;
+  box-shadow: 0 22px 70px rgba(0, 0, 0, .35);
+}
+.ppe-report-header, .ppe-report-footer {
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  gap: 15px;
+  padding: 18px 25px;
+  background: #fff;
+}
+.ppe-report-header { border-bottom: 1px solid #dce5ef; }
+.ppe-report-header h2 { font-size: 22px; margin: 3px 0; }
+.ppe-report-header p { font-size: 12px; color: #6b8297; margin: 0; }
+.ppe-report-kicker { font-size: 10px; color: #24654a; font-weight: 850; letter-spacing: .09em; }
+.ppe-report-content {
+  min-height: 0;
+  display: grid;
+  grid-template-columns: minmax(0, 1.65fr) minmax(270px, .85fr);
+  gap: 18px;
+  overflow: auto;
+  padding: 22px 25px;
+}
+.ppe-report-paper {
+  padding: 25px;
+  border: 1px solid #dce7ef;
+  border-radius: 10px;
+  background: #fff;
+  box-shadow: 0 5px 18px rgba(24, 52, 83, .06);
+  min-width: 0;
+}
+.ppe-report-document-heading { border-bottom: 2px solid #d9e6ee; padding-bottom: 12px; }
+.ppe-report-document-heading > span { color: #217650; letter-spacing: .1em; font-size: 10px; font-weight: 850; }
+.ppe-report-document-heading h3 { margin: 4px 0 5px; font-size: 25px; color: #122948; }
+.ppe-report-document-heading small { color: #607b92; }
+.ppe-report-metadata { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px; margin: 19px 0; }
+.ppe-report-metadata > div { display: flex; flex-direction: column; gap: 4px; min-width: 0; }
+.ppe-report-metadata span { font-size: 11px; color: #6a8396; }
+.ppe-report-metadata strong { font-size: 12px; overflow-wrap: anywhere; }
+.ppe-report-paper h4 { margin: 20px 0 9px; font-size: 14px; color: #172f4a; }
+.ppe-report-paper > p { margin: 5px 0; font-size: 12px; line-height: 1.55; }
+.ppe-report-ppe { border: 1px solid #dae5ee; background: #f5f8fa; border-radius: 9px; padding: 12px; display: flex; flex-wrap: wrap; gap: 13px; font-size: 11px; }
+.ppe-report-ppe span { display: flex; flex-direction: column; gap: 3px; }
+.ppe-report-ppe strong { font-size: 12px; color: #203a54; }
+.ppe-report-secondary { color: #62798b; font-size: 12px; line-height: 1.55; overflow-wrap: anywhere; }
+.ppe-report-selected-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; }
+.ppe-report-frame-card { min-width: 0; border: 1px solid #dce6ee; border-radius: 9px; overflow: hidden; }
+.ppe-report-thumbnail { display: block; width: 100%; height: 138px; object-fit: contain; background: #102339; }
+.ppe-report-image-missing { height: 138px; display: grid; place-items: center; background: #eaf0f5; color: #607589; font-size: 12px; }
+.ppe-report-frame-card > div:last-child { display: flex; flex-direction: column; padding: 9px 11px; gap: 5px; font-size: 11px; overflow-wrap: anywhere; }
+.ppe-report-frame-card span { color: #607589; }
+.ppe-report-disclaimer { margin-top: 18px !important; color: #698198; font-size: 11px !important; }
+.ppe-report-controls {
+  align-self: start;
+  padding: 20px;
+  border: 1px solid #dce7ef;
+  border-radius: 11px;
+  background: #fff;
+  min-width: 0;
+}
+.ppe-report-controls h3 { margin: 0 0 5px; font-size: 16px; }
+.ppe-report-controls > p { color: #60798c; font-size: 12px; line-height: 1.55; margin: 5px 0 13px; }
+.ppe-report-selection-summary { display: flex; justify-content: space-between; align-items: center; gap: 9px; padding: 13px 0; border-top: 1px solid #e1eaf0; font-size: 12px; }
+.ppe-report-selection-summary span { color: #4c8668; text-align: right; }
+.ppe-report-reset { width: 100%; margin-bottom: 10px; }
+.ppe-report-frame-options { max-height: 380px; overflow-y: auto; border-top: 1px solid #e1eaf0; }
+.ppe-report-frame-option { display: flex; gap: 12px; align-items: start; padding: 12px 3px; border-bottom: 1px solid #e1eaf0; cursor: pointer; }
+.ppe-report-frame-option input { accent-color: #158252; margin-top: 3px; flex-shrink: 0; }
+.ppe-report-frame-option span { display: flex; flex-direction: column; gap: 3px; min-width: 0; }
+.ppe-report-frame-option strong { font-size: 12px; }
+.ppe-report-frame-option small { font-size: 11px; color: #74869b; line-height: 1.45; overflow-wrap: anywhere; }
+.ppe-report-footer { border-top: 1px solid #dce5ef; flex-wrap: wrap; }
+.ppe-report-footer > span { font-size: 11px; color: #60798c; }
+.ppe-report-footer > div { display: flex; gap: 10px; align-items: center; margin-left: auto; }
+.ppe-report-footer button:not(.outline-button) { border: 0; border-radius: 8px; color: white; background: #15794e; padding: 11px 16px; font-weight: 750; }
+.ppe-report-footer button:not(.outline-button):hover { background: #11633f; }
+.ppe-report-footer button:disabled { opacity: .58; cursor: not-allowed; }
+.ppe-report-error { flex-basis: 100%; margin: 0; padding: 9px 11px; border: 1px solid #efb6ae; border-radius: 7px; color: #982f2f; background: #fff0ee; font-size: 12px; }
+
+.dashboard.dark-theme .ppe-report-dialog { background: #102035; color: #e8f2fb; }
+.dashboard.dark-theme .ppe-report-header, .dashboard.dark-theme .ppe-report-footer,
+.dashboard.dark-theme .ppe-report-controls { background: #172b44; border-color: #335371; }
+.dashboard.dark-theme .ppe-report-header p,
+.dashboard.dark-theme .ppe-report-controls > p,
+.dashboard.dark-theme .ppe-report-footer > span { color: #b6c8db; }
+.dashboard.dark-theme .ppe-report-frame-options,
+.dashboard.dark-theme .ppe-report-frame-option,
+.dashboard.dark-theme .ppe-report-selection-summary { border-color: #36516e; }
+.dashboard.dark-theme .ppe-report-frame-option small { color: #b0c4d7; }
+/* The document preview intentionally resembles the light paper PDF in both themes. */
+
+@media (max-width: 900px) {
+  .ppe-report-content { grid-template-columns: 1fr; }
+  .ppe-report-frame-options { max-height: 230px; }
+}
+@media (max-width: 600px) {
+  .ppe-report-backdrop { padding: 7px; }
+  .ppe-report-dialog { max-height: calc(100vh - 14px); }
+  .ppe-report-content { padding: 13px; }
+  .ppe-report-header, .ppe-report-footer { padding: 13px; }
+  .ppe-report-paper, .ppe-report-controls { padding: 16px; }
+  .ppe-report-selected-grid { grid-template-columns: 1fr; }
+  .ppe-report-header h2 { font-size: 19px; }
+}
diff --git a/my-app/src/ReportPreview.jsx b/my-app/src/ReportPreview.jsx
new file mode 100644
index 0000000..e7600d1
--- /dev/null
+++ b/my-app/src/ReportPreview.jsx
@@ -0,0 +1,226 @@
+import { useEffect, useState } from 'react';
+import './ReportPreview.css';
+
+const MAX_FRAMES = 6;
+
+const findingLabels = {
+  confirmed: 'Confirmed PPE concern',
+  false_alert: 'False alert / PPE present',
+  inconclusive: 'Inconclusive - more evidence required',
+};
+
+function videoTime(value) {
+  const seconds = Math.max(0, Math.floor(Number(value) || 0));
+  return [Math.floor(seconds / 3600), Math.floor(seconds / 60) % 60, seconds % 60]
+    .map((n) => String(n).padStart(2, '0')).join(':');
+}
+
+function ppeLabel(value) {
+  return { yes: 'Reported missing', no: 'No violation reported', unclear: 'Unclear' }[value] || 'Not recorded';
+}
+
+function displayTime(value) {
+  if (!value || Number.isNaN(Date.parse(value))) return 'Not recorded';
+  return new Intl.DateTimeFormat('en-SG', {
+    timeZone: 'Asia/Singapore', day: 'numeric', month: 'short', year: 'numeric',
+    hour: 'numeric', minute: '2-digit', hour12: true,
+  }).format(new Date(value));
+}
+
+function EvidenceThumbnail({ src, alt }) {
+  const [failed, setFailed] = useState(false);
+  useEffect(() => { setFailed(false); }, [src]);
+  if (!src || failed) return <div className="ppe-report-image-missing">Evidence unavailable</div>;
+  return <img className="ppe-report-thumbnail" src={src} alt={alt} loading="eager"
+    onError={() => setFailed(true)} />;
+}
+
+export default function ReportPreview({ incident, frames, review, onClose }) {
+  const [selectedIds, setSelectedIds] = useState([]);
+  const [availableIds, setAvailableIds] = useState([]);
+  const [recommendedIds, setRecommendedIds] = useState([]);
+  const [selectionMode, setSelectionMode] = useState('automatic');
+  const [loading, setLoading] = useState(true);
+  const [exporting, setExporting] = useState(false);
+  const [error, setError] = useState('');
+
+  useEffect(() => {
+    let active = true;
+    setLoading(true);
+    setError('');
+    fetch(`/api/incidents/${incident.id}/report-options`)
+      .then(async (response) => {
+        const result = await response.json().catch(() => ({}));
+        if (!response.ok) throw new Error(result.detail || `Could not load report options (${response.status}).`);
+        return result;
+      })
+      .then((result) => {
+        if (!active) return;
+        const allowed = Array.isArray(result.availableIds) ? result.availableIds : [];
+        const suggested = Array.isArray(result.recommendedIds) ? result.recommendedIds : [];
+        setAvailableIds(allowed);
+        setRecommendedIds(suggested);
+        setSelectedIds(suggested);
+        setSelectionMode('automatic');
+      })
+      .catch((err) => { if (active) setError(err.message); })
+      .finally(() => { if (active) setLoading(false); });
+    return () => { active = false; };
+  }, [incident.id]);
+
+  const available = new Set(availableIds);
+  const sortedFrames = frames.slice().sort((left, right) =>
+    Number(left.video_seconds || 0) - Number(right.video_seconds || 0) || left.id - right.id);
+  const shownFrames = sortedFrames.filter((frame) => selectedIds.includes(frame.id));
+  const latestReview = review.history?.find((entry) => entry.action === 'review');
+  const latestResolution = review.history?.find((entry) => entry.action === 'resolve');
+
+  function toggleFrame(id) {
+    setError('');
+    setSelectionMode('manual');
+    setSelectedIds((current) => current.includes(id)
+      ? current.filter((candidate) => candidate !== id)
+      : current.length < MAX_FRAMES ? [...current, id] : current);
+  }
+
+  function resetRecommendations() {
+    setSelectedIds(recommendedIds);
+    setSelectionMode('automatic');
+    setError('');
+  }
+
+  async function downloadPdf() {
+    setExporting(true);
+    setError('');
+    try {
+      const response = await fetch(`/api/incidents/${incident.id}/summary-report`, {
+        method: 'POST',
+        headers: { 'Content-Type': 'application/json' },
+        body: JSON.stringify({ analysis_ids: selectedIds }),
+      });
+      if (!response.ok) {
+        const result = await response.json().catch(() => ({}));
+        throw new Error(result.detail || `Report generation failed (${response.status}).`);
+      }
+      const blob = await response.blob();
+      const url = URL.createObjectURL(blob);
+      const download = document.createElement('a');
+      download.href = url;
+      download.download = `PPE_Incident_${incident.id}_Summary.pdf`;
+      document.body.appendChild(download);
+      download.click();
+      download.remove();
+      setTimeout(() => URL.revokeObjectURL(url), 60000);
+    } catch (err) {
+      setError(err.message);
+    } finally {
+      setExporting(false);
+    }
+  }
+
+  return (
+    <div className="ppe-report-backdrop" onMouseDown={(event) => {
+      if (event.target === event.currentTarget) onClose();
+    }}>
+      <section className="ppe-report-dialog" role="dialog" aria-modal="true"
+        aria-labelledby="ppe-report-title">
+        <header className="ppe-report-header">
+          <div>
+            <span className="ppe-report-kicker">STAGE 6A · INCIDENT DOCUMENTATION</span>
+            <h2 id="ppe-report-title">Summary Report Preview</h2>
+            <p>Incident #{incident.id} · {incident.videoName ? 'Video analysis' : 'Image analysis'}</p>
+          </div>
+          <button type="button" className="outline-button" onClick={onClose}>✕ Close</button>
+        </header>
+
+        <div className="ppe-report-content">
+          <div className="ppe-report-paper" aria-label="Report content preview">
+            <div className="ppe-report-document-heading">
+              <span>PPE SAFETY MONITORING</span>
+              <h3>Incident Summary</h3>
+              <small>AI assessments are not verified safety findings.</small>
+            </div>
+            <div className="ppe-report-metadata">
+              <div><span>Incident</span><strong>#{incident.id} · {incident.status}</strong></div>
+              <div><span>Location</span><strong>{incident.location}</strong></div>
+              <div><span>Model</span><strong>{incident.model || 'Not recorded'}</strong></div>
+              <div><span>Detected</span><strong>{displayTime(incident.createdAt)}</strong></div>
+              <div><span>Source</span><strong>{incident.videoName || incident.camera || 'Manual upload'}</strong></div>
+              <div><span>Saved analyses</span><strong>{frames.length}</strong></div>
+            </div>
+            <h4>AI-reported PPE concerns</h4>
+            <div className="ppe-report-ppe">
+              <span>Helmet: <strong>{ppeLabel(incident.helmetViolation)}</strong></span>
+              <span>Vest: <strong>{ppeLabel(incident.vestViolation)}</strong></span>
+              <span>Boots: <strong>{ppeLabel(incident.bootsViolation)}</strong></span>
+            </div>
+            <h4>Human verification</h4>
+            <p><strong>{findingLabels[review.currentFinding] || 'Not human verified'}</strong></p>
+            {latestReview && review.currentFinding && (
+              <p className="ppe-report-secondary">{latestReview.reviewer}: {latestReview.notes}</p>
+            )}
+            {latestResolution?.notes && (
+              <p className="ppe-report-secondary">Corrective action: {latestResolution.notes}</p>
+            )}
+            <h4>Selected evidence ({shownFrames.length})</h4>
+            {loading ? <p className="ppe-report-secondary">Checking saved evidence…</p> :
+              shownFrames.length ? (
+                <div className="ppe-report-selected-grid">
+                  {shownFrames.map((frame) => (
+                    <article className="ppe-report-frame-card" key={frame.id}>
+                      <EvidenceThumbnail src={frame.evidence_url}
+                        alt={`Evidence at ${videoTime(frame.video_seconds)}`} />
+                      <div>
+                        <strong>{incident.videoName ? videoTime(frame.video_seconds) : 'Saved photograph'}</strong>
+                        <span>{frame.overall_status} · Helmet: {ppeLabel(frame.helmet_violation)}</span>
+                        <span>Vest: {ppeLabel(frame.vest_violation)} · Boots: {ppeLabel(frame.boots_violation)}</span>
+                      </div>
+                    </article>
+                  ))}
+                </div>
+              ) : <p className="ppe-report-secondary">No saved evidence selected. You can still export the incident record.</p>}
+            <p className="ppe-report-disclaimer">Preview layout only. The downloaded PDF uses the same saved incident data and selected frames. An entire source video is not embedded.</p>
+          </div>
+
+          <aside className="ppe-report-controls" aria-label="Select frames for the report">
