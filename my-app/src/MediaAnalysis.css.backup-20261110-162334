/* Additional styles scoped to the remote image/video analysis panel. */
.analysis-panel .ppe-video-controls {
  display: grid;
  grid-template-columns: minmax(220px, 1.3fr) minmax(210px, 1fr) minmax(225px, 1fr) auto;
  align-items: end;
  gap: 14px;
  border: 1px solid #dbe5ef;
  background: #f9fbfd;
  border-radius: 12px;
  padding: 17px;
  margin: 20px 0 15px;
}
.analysis-panel .ppe-video-controls > div:first-child { grid-column: 1 / -1; }
.analysis-panel .ppe-video-controls h3,
.analysis-panel .ppe-media-card h3 { margin: 0 0 8px; font-size: 16px; }
.analysis-panel .ppe-video-controls p { margin: 0; }
.analysis-panel .ppe-video-controls label { display: grid; gap: 8px; min-width: 0; font-size: 13px; font-weight: 650; }
.analysis-panel .ppe-video-controls input { max-width: 100%; }
.analysis-panel .ppe-video-controls select { width: 100%; }
.analysis-panel .ppe-video-buttons { display: flex; gap: 8px; flex-wrap: wrap; }
.analysis-panel .ppe-video-controls .ppe-video-progress,
.analysis-panel .ppe-video-controls .analysis-error { grid-column: 1 / -1; }
.analysis-panel .ppe-video-progress { color: #475569; font-size: 13px; }
.analysis-panel .ppe-media-results-grid {
  display: grid;
  grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
  gap: 18px;
  align-items: start;
  margin-top: 22px;
}
.analysis-panel .ppe-media-card {
  min-width: 0;
  border: 1px solid #dbe5ef;
  border-radius: 12px;
  padding: 18px;
  background: #fff;
}
.analysis-panel .ppe-media-photo,
.analysis-panel .ppe-media-video,
.analysis-panel .ppe-frame-photo { display: block; max-width: 100%; width: 100%; height: auto; object-fit: contain; border-radius: 9px; background: #0b1728; }
.analysis-panel .ppe-media-photo { max-height: 440px; }
.analysis-panel .ppe-media-video { max-height: 380px; }
.analysis-panel .ppe-frame-photo { max-height: 270px; }
.analysis-panel .ppe-media-caption { color: #64748b; font-size: 12px; line-height: 1.5; overflow-wrap: anywhere; margin: 9px 0; }
.analysis-panel .ppe-current-frame { margin-top: 20px; padding-top: 16px; border-top: 1px solid #dbe5ef; }
.analysis-panel .ppe-current-frame h4 { font-size: 13px; margin: 0 0 12px; }
.analysis-panel .ppe-empty-preview { display: flex; align-items: center; justify-content: center; text-align: center; padding: 30px; min-height: 230px; background: #f4f7fb; border: 1px dashed #cbd5e1; border-radius: 9px; color: #64748b; font-size: 13px; }
.analysis-panel .ppe-output-title { display: flex; align-items: center; justify-content: space-between; gap: 8px; flex-wrap: wrap; }
.analysis-panel .ppe-no-result, .analysis-panel .ppe-status-message { padding: 28px 0; color: #64748b; }
.analysis-panel .ppe-overall-heading { font-size: 15px; font-weight: 750; margin: 14px 0; }
.analysis-panel .ppe-category-list { display: grid; gap: 0; border: 1px solid #e2e8f0; border-radius: 10px; overflow: hidden; }
.analysis-panel .ppe-category-row { display: flex; align-items: center; justify-content: space-between; gap: 14px; padding: 11px 13px; border-bottom: 1px solid #e2e8f0; font-size: 13px; }
.analysis-panel .ppe-category-row:last-child { border-bottom: 0; }
.analysis-panel .ppe-item-pill, .analysis-panel .ppe-overall-chip { border-radius: 99px; font-size: 11px; font-weight: 750; padding: 5px 9px; white-space: nowrap; }
.analysis-panel .ppe-item-yes, .analysis-panel .ppe-overall-violation { background: #fee2e2; color: #991b1b; }
.analysis-panel .ppe-item-no, .analysis-panel .ppe-overall-compliant { background: #dcfce7; color: #166534; }
.analysis-panel .ppe-item-unclear, .analysis-panel .ppe-overall-unclear, .analysis-panel .ppe-overall-boots_unverified { background: #fef3c7; color: #92400e; }
.analysis-panel .ppe-overall-no_workers { background: #e2e8f0; color: #475569; }
.analysis-panel .ppe-result-meta { display: flex; flex-wrap: wrap; gap: 10px 20px; font-size: 12px; margin: 18px 0 10px; color: #475569; }
.analysis-panel .ppe-incident-note { margin: 16px 0; padding: 12px; background: #eff6ff; border-radius: 8px; color: #1e40af; font-size: 12px; }
.analysis-panel .ppe-workers-breakdown { margin: 14px 0; }
.analysis-panel .ppe-workers-breakdown summary { cursor: pointer; font-weight: 650; font-size: 13px; }
.analysis-panel .ppe-workers-scroll, .analysis-panel .ppe-history-scroll { max-width: 100%; overflow-x: auto; }
.analysis-panel .ppe-workers-scroll table, .analysis-panel .ppe-history-scroll table { width: 100%; border-collapse: collapse; font-size: 12px; }
.analysis-panel .ppe-workers-scroll th, .analysis-panel .ppe-history-scroll th { text-align: left; background: #f1f5f9; color: #475569; }
.analysis-panel .ppe-workers-scroll th, .analysis-panel .ppe-workers-scroll td, .analysis-panel .ppe-history-scroll th, .analysis-panel .ppe-history-scroll td { padding: 9px; border-bottom: 1px solid #e2e8f0; }
.analysis-panel .ppe-video-history { margin: 21px 0 0; border: 1px solid #dbe5ef; border-radius: 12px; padding: 17px; }
.analysis-panel .ppe-video-history summary { cursor: pointer; font-weight: 750; font-size: 14px; margin-bottom: 15px; }
.analysis-panel .ppe-history-selected { background: #eaf6ef; }
.analysis-panel .ppe-frame-link { color: #166534; background: transparent; padding: 4px 6px; border: 1px solid transparent; text-decoration: underline; }
.analysis-panel .ppe-frame-link:hover { background: #dcfce7; color: #14532d; border-color: #86efac; }
.dark-theme .analysis-panel .ppe-video-controls,
.dark-theme .analysis-panel .ppe-media-card,
.dark-theme .analysis-panel .ppe-video-history { background: #192b40; border-color: #36516e; color: #f1f5f9; }
.dark-theme .analysis-panel .ppe-empty-preview { background: #14243a; border-color: #46617f; }
.dark-theme .analysis-panel .ppe-media-caption,
.dark-theme .analysis-panel .ppe-result-meta,
.dark-theme .analysis-panel .ppe-video-progress { color: #b4c8df; }
.dark-theme .analysis-panel .ppe-current-frame,
.dark-theme .analysis-panel .ppe-category-list,
.dark-theme .analysis-panel .ppe-category-row { border-color: #36516e; }
.dark-theme .analysis-panel .ppe-workers-scroll th,
.dark-theme .analysis-panel .ppe-history-scroll th { background: #234365; color: #dae8f8; }
.dark-theme .analysis-panel .ppe-workers-scroll td,
.dark-theme .analysis-panel .ppe-history-scroll td { border-color: #36516e; }
.dark-theme .analysis-panel .ppe-history-selected { background: #234365; }
.dark-theme .analysis-panel .ppe-incident-note { background: #163e5f; color: #c8e5ff; }
.dark-theme .analysis-panel .ppe-frame-link { color: #86efac; }
@media (max-width: 1100px) {
  .analysis-panel .ppe-video-controls { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .analysis-panel .ppe-video-buttons { grid-column: 1 / -1; }
}
@media (max-width: 750px) {
  .analysis-panel .ppe-video-controls, .analysis-panel .ppe-media-results-grid { grid-template-columns: minmax(0, 1fr); }
  .analysis-panel .ppe-video-buttons { grid-column: auto; }
}


/* Compact video analysis layout - PPE update */
.analysis-panel .ppe-frame-photo,
.analysis-panel .ppe-media-video {
  max-height: 380px;
  object-fit: contain;
}

.analysis-panel .ppe-results-column {
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 14px;
}

.analysis-panel .ppe-results-column .ppe-video-history {
  margin: 0;
  padding: 13px;
}

.analysis-panel .ppe-results-column .ppe-video-history summary {
  margin-bottom: 8px;
  font-size: 13px;
}

.analysis-panel .ppe-results-column .ppe-history-scroll table {
  min-width: 0;
  font-size: 11px;
}

.analysis-panel .ppe-results-column .ppe-history-scroll th,
.analysis-panel .ppe-results-column .ppe-history-scroll td {
  padding: 8px 6px;
}
