# COPY THIS FILE TO backend/.env and edit it. Do not commit .env.
# Use the same supervisor-hosted URL which worked in your Jupyter notebook.
OLLAMA_BASE_URL=http://YOUR_REMOTE_OLLAMA_SERVER:80
# Whitelist only vision-capable models installed on that remote server.
OLLAMA_MODELS=qwen3.8:27b
OLLAMA_TIMEOUT_SECONDS=240
