+
+/* Stage 2: compact incident search and filtering on the active/history pages. */
+.ppe-incident-filters {
+  display: grid;
+  grid-template-columns: minmax(175px, 1.6fr) repeat(3, minmax(125px, 1fr)) auto;
+  gap: 12px;
+  align-items: end;
+  margin-top: 20px;
+  padding: 16px;
+  background: #f8fafc;
+  border: 1px solid #e2e8f0;
+  border-radius: 12px;
+}
+
+.ppe-incident-filters label {
+  min-width: 0;
+  display: flex;
+  flex-direction: column;
+  gap: 6px;
+  color: #475569;
+  font-size: 12px;
+  font-weight: 650;
+}
+
+.ppe-incident-filters input,
+.ppe-incident-filters select {
+  width: 100%;
+  min-width: 0;
+  height: 40px;
+  padding: 8px 10px;
+  border: 1px solid #cbd5e1;
+  border-radius: 8px;
+  background: #fff;
+  color: #172033;
+  font: inherit;
+  font-size: 13px;
+}
+
+.ppe-incident-filters input:focus-visible,
+.ppe-incident-filters select:focus-visible,
+.ppe-incident-filters button:focus-visible {
+  outline: 2px solid #16a34a;
+  outline-offset: 2px;
+}
+
+.ppe-incident-filters .ppe-clear-filters {
+  height: 40px;
+  padding: 8px 12px;
+  border: 1px solid #94a3b8;
+  border-radius: 8px;
+  background: transparent;
+  color: #334155;
+  font-weight: 650;
+  white-space: nowrap;
+}
+
+.ppe-incident-filters .ppe-clear-filters:hover {
+  background: #e2e8f0;
+}
+
+.ppe-incident-table-date {
+  font-size: 12px;
+  white-space: nowrap;
+}
+
+.ppe-app-shell.dark-theme .ppe-incident-filters {
+  background: #192b40;
+  border-color: #36516e;
+}
+
+.ppe-app-shell.dark-theme .ppe-incident-filters label {
+  color: #b4c8df;
+}
+
+.ppe-app-shell.dark-theme .ppe-incident-filters input,
+.ppe-app-shell.dark-theme .ppe-incident-filters select {
+  background: #14243a;
+  border-color: #46617f;
+  color: #f1f5f9;
+}
+
+.ppe-app-shell.dark-theme .ppe-incident-filters .ppe-clear-filters {
+  border-color: #46617f;
+  color: #dbeafe;
+}
+
+.ppe-app-shell.dark-theme .ppe-incident-filters .ppe-clear-filters:hover {
+  background: #234365;
+}
+
+@media (max-width: 1100px) {
+  .ppe-incident-filters {
+    grid-template-columns: repeat(2, minmax(0, 1fr));
+  }
+  .ppe-incident-filters .ppe-clear-filters {
+    justify-self: start;
+  }
+}
+
+@media (max-width: 580px) {
+  .ppe-incident-filters {
+    grid-template-columns: minmax(0, 1fr);
+  }
+  .ppe-incident-filters .ppe-clear-filters {
+    width: 100%;
+  }
+}
