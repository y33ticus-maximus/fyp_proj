+.dashboard.dark-theme .detail-modal .ppe-human-finding.false_alert { color: #b7f5cb; background: #215039; }
+.dashboard.dark-theme .detail-modal .ppe-human-finding.inconclusive { color: #ffdea1; background: #533e1c; }
+.dashboard.dark-theme .detail-modal .ppe-review-decision-note { color: #bedaf0; background: #1d3e58; border-color: #35607f; }
+.dashboard.dark-theme .detail-modal .ppe-review-close-actions,
+.dashboard.dark-theme .detail-modal .ppe-review-history { border-color: #36516e; }
+.dashboard.dark-theme .detail-modal .ppe-review-help { background: #1c3450; color: #bdcfde; }
+.dashboard.dark-theme .detail-modal .ppe-review-error { color: #ffc2bb; background: #4b2828; border-color: #99534a; }
+.dashboard.dark-theme .detail-modal .ppe-review-feedback { color: #b7efcc; background: #1f4534; border-color: #417556; }
+.dashboard.dark-theme .detail-modal .ppe-review-history li strong { color: #f1f7fa; }
+.dashboard.dark-theme .detail-modal .ppe-review-history li small { color: #b2c4d4; }
+.dashboard.dark-theme .detail-modal .ppe-review-history li p { color: #cad9e5; }
+
+@media (max-width: 650px) {
+  .dashboard .detail-modal .ppe-human-review { padding: 14px; }
+  .detail-modal .ppe-review-form-grid { grid-template-columns: 1fr; gap: 0; }
+}
