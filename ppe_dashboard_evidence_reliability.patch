+}
+.detail-modal .ppe-evidence-surface .ppe-evidence-zoom-trigger:disabled {
+  opacity: 1;
+  cursor: default;
+}
+.ppe-evidence-status {
+  position: absolute;
+  inset: 0;
+  display: flex;
+  flex-direction: column;
+  justify-content: center;
